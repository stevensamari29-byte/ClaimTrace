{
  "$defs": {
    "Calculation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "formula",
        "value",
        "unit",
        "evidence_ids"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Company": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "ticker": {
          "pattern": "^[A-Za-z0-9.\\-]{1,12}$",
          "title": "Ticker",
          "type": "string"
        },
        "cik": {
          "pattern": "^\\d{1,10}$",
          "title": "Cik",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ticker",
        "cik"
      ],
      "title": "Company",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "document": {
          "title": "Document",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "published_at": {
          "format": "date",
          "title": "Published At",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "concept": {
          "title": "Concept",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "live_sec",
            "cached_sec",
            "live_zetaris"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        }
      },
      "required": [
        "id",
        "document",
        "url",
        "published_at",
        "period_start",
        "period_end",
        "unit",
        "value",
        "concept",
        "locator",
        "source_mode"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "classification": {
          "enum": [
            "supported",
            "contradicted",
            "incomplete",
            "unresolved"
          ],
          "title": "Classification",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "claim_id",
        "classification",
        "evidence_ids",
        "explanation"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "company": {
      "$ref": "#/$defs/Company"
    },
    "fiscal_year": {
      "title": "Fiscal Year",
      "type": "integer"
    },
    "period": {
      "title": "Period",
      "type": "string"
    },
    "as_of": {
      "format": "date",
      "title": "As Of",
      "type": "string"
    },
    "evidence_backend": {
      "title": "Evidence Backend",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "calculations": {
      "items": {
        "$ref": "#/$defs/Calculation"
      },
      "title": "Calculations",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "unresolved_questions": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    },
    "human_review_status": {
      "const": "required",
      "default": "required",
      "title": "Human Review Status",
      "type": "string"
    },
    "integration_status": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Integration Status",
      "type": "object"
    }
  },
  "required": [
    "company",
    "fiscal_year",
    "period",
    "as_of",
    "evidence_backend",
    "status",
    "evidence",
    "claims",
    "calculations",
    "findings",
    "limitations",
    "unresolved_questions",
    "integration_status"
  ],
  "title": "InvestigationResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
