# Variable names only. No secrets or personal contact details belong in Git.
# This file is documentation, not automatically loaded by the app.
CLAIMTRACE_SEC_MODE=cache_first
# For live SEC requests: real owner-approved monitored email only.
# Backend constructs: ClaimTrace Hackathon Team <this address>.
SEC_CONTACT_EMAIL=
# Existing secure config path outside this repository, never copied here.
ZETARIS_CONFIG_PATH=
# Only after approval and verified creation of a financial view/table.
CLAIMTRACE_ZETARIS_TABLE=
# Future Nightshift acceptance: never put these values in frontend/VITE variables.
NIGHTSHIFT_INFERENCE_ENABLED=false
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_RUNTIME_TOKEN=
# Select an actually discovered Meterless routing ID; never guess a model ID.
NIGHTSHIFT_MODEL_ID=
