# Variable names only. No secrets or personal contact details belong in Git.
# This file is documentation, not automatically loaded by the app.
CLAIMTRACE_SEC_MODE=cache_first
# For live SEC requests: real owner-approved monitored email only.
# Backend constructs: ClaimTrace Hackathon Team <this address>.
SEC_CONTACT_EMAIL=
# Existing secure config path outside this repository, never copied here.
ZETARIS_CONFIG_PATH=
# Only after approval and verified creation of a financial view/table.
CLAIMTRACE_ZETARIS_TABLE=
# Opt-in standalone structured-provider preparation; no verified live inference.
# Never put these values in frontend/VITE variables. Process environment only.
NIGHTSHIFT_INFERENCE_ENABLED=false
NIGHTSHIFT_BASE_URL=
NIGHTSHIFT_RUNTIME_TOKEN=
# Select an actually discovered Meterless routing ID; never guess a model ID.
# Routing IDs alone do not establish the underlying Nemotron model.
NIGHTSHIFT_MODEL_ID=
# Direct hosted NVIDIA is separate from Nightshift. No automatic fallback.
# Key is read only from the backend process or Git-ignored .env.local.
NVIDIA_API_KEY=
NVIDIA_INFERENCE_ENABLED=false
# Choose an actually discovered and tested Nemotron ID; no guessed default.
NVIDIA_MODEL_ID=
# Optional ONE model-generated typed-format correction within the same budget.
NVIDIA_FORMAT_CORRECTION_ENABLED=false
# Text-only observed public/internal Super pair; NOT verified VL/weight equivalence.
# Separate explicit opt-in; every other response-model mismatch rejects.
NVIDIA_ALLOW_OBSERVED_SUPER_ROUTE=false
